<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ro.victorrentea.pptx-backup</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-c</string><string>exec "$HOME/workspace/powerpoint-addons/backup/pptx-backup.sh"</string></array>
  <key>StartInterval</key><integer>21600</integer>
  <key>RunAtLoad</key><true/>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>/tmp/pptx-backup.log</string>
  <key>StandardErrorPath</key><string>/tmp/pptx-backup.log</string>
</dict>
</plist>
